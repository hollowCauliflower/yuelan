    <!-- 月经期 -->
    <string name="cycle_menstrual_period_name">月经期</string>
    <string name="cycle_menstrual_period_description">月经来潮期间，子宫内膜脱落排出体外。持续时间通常为3–7天。</string>
    <string name="cycle_menstrual_period_tips">注意保暖，多休息，避免剧烈运动和生冷食物。</string>

    <!-- 卵泡期 -->
    <string name="cycle_follicular_phase_name">卵泡期</string>
    <string name="cycle_follicular_phase_description">月经结束后到排卵前，卵泡发育成熟。雌激素水平逐渐升高。</string>
    <string name="cycle_follicular_phase_tips">适合运动，皮肤状态较好，是学习和工作的黄金时期。</string>

    <!-- 排卵期 -->
    <string name="cycle_ovulation_period_name">排卵期</string>
    <string name="cycle_ovulation_period_description">卵子从卵巢排出的时期，最容易受孕。通常持续3–4天。</string>
    <string name="cycle_ovulation_period_tips">备孕最佳时期，注意营养均衡，如有腹痛属正常现象。</string>

    <!-- 黄体期 -->
    <string name="cycle_lute_phase_name">黄体期</string>
    <string name="cycle_lute_phase_description">排卵后到下次月经前，黄体形成并分泌孕激素，为怀孕做准备。</string>
    <string name="cycle_lute_phase_tips">可能出现经前症状，注意情绪管理，可适当补充维生素B6。</string>

