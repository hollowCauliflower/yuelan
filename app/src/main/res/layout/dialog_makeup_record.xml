<?xml version="1.0" encoding="utf-8"?>
<!-- 补签记录弹窗：日期副标题 + 四阶段卡片网格 + 批量调整入口 + 取消按钮。
     阶段卡片的圆角底色在代码里按阶段色动态生成，这里只搭结构。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calendar_makeup_record"
        android:textColor="@color/text_title"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_makeup_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:text="@string/makeup_select_phase_hint"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

    <!-- 第一行：经期 / 卵泡期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_menstrual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_menstrual_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cycle_menstrual_period_name"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/makeup_phase_desc_menstrual"
                android:textColor="@color/text_sub"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_follicular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_follicular_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cycle_follicular_phase_name"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/makeup_phase_desc_follicular"
                android:textColor="@color/text_sub"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：排卵期 / 黄体期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_ovulation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_ovulation_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cycle_ovulation_period_name"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/makeup_phase_desc_ovulation"
                android:textColor="@color/text_sub"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_luteal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_luteal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cycle_lute_phase_name"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/makeup_phase_desc_luteal"
                android:textColor="@color/text_sub"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider"/>

    <!-- 批量调整入口：进入涂抹式范围编辑器 -->
    <LinearLayout
        android:id="@+id/layout_batch_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/makeup_batch_edit"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/makeup_batch_edit_desc"
                android:textColor="@color/text_hint"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_hint"
            android:textSize="22sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_outline_background"
        android:gravity="center"
        android:text="@string/dialog_cancel"
        android:textColor="@color/text_sub"
        android:textSize="14sp"/>
</LinearLayout>
