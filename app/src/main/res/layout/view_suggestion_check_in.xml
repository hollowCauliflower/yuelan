<?xml version="1.0" encoding="utf-8"?>
<!-- 每日建议卡片底部的一键打卡：心情 + 睡眠/饮水微习惯 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/daily_suggestion_mood_title"
        android:textColor="@color/text_hint"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_mood_good"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:paddingEnd="20dp"
            android:text="@string/daily_suggestion_mood_good"
            android:textColor="@color/text_body"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_mood_okay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:paddingEnd="20dp"
            android:text="@string/daily_suggestion_mood_okay"
            android:textColor="@color/text_body"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_mood_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:paddingEnd="20dp"
            android:text="@string/daily_suggestion_mood_low"
            android:textColor="@color/text_body"
            android:textSize="13sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/daily_suggestion_habit_title"
        android:textColor="@color/text_hint"
        android:textSize="12sp"/>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_habit_sleep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/daily_suggestion_habit_sleep"
        android:textColor="@color/text_body"
        android:textSize="13sp"/>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_habit_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/daily_suggestion_habit_water"
        android:textColor="@color/text_body"
        android:textSize="13sp"/>

</merge>
