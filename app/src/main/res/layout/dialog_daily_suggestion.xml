<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/daily_suggestion_date_placeholder"
            android:textColor="@color/text_title"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/phase_tag_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/cycle_menstrual_period_name"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- 今日天气：仅查看今天时展示，定位/网络失败时隐藏 -->
    <TextView
        android:id="@+id/tv_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 天气 × 阶段的暖心提醒：没有需要提醒的组合时隐藏 -->
    <TextView
        android:id="@+id/tv_weather_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_body"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/daily_suggestion_title"
        android:textColor="@color/text_sub"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/inset_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/daily_suggestion_default"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tv_prev_day"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline_background"
            android:gravity="center"
            android:text="@string/daily_suggestion_prev_day"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_next_day"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline_background"
            android:gravity="center"
            android:text="@string/daily_suggestion_next_day"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary_background"
        android:gravity="center"
        android:text="@string/daily_suggestion_close"
        android:textColor="@android:color/white"
        android:textSize="14sp"/>

    <!-- 今日不再提醒：作为主操作下方的脚注选项，与按钮保持舒展间距 -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_no_remind_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/daily_suggestion_no_remind_today"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
