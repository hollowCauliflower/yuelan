<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/divider"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/view_phase_color"
                    android:layout_width="8dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_detail_date_placeholder"
                        android:textColor="@color/text_title"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_phase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cycle_menstrual_period_name"
                        android:textColor="@color/text_sub"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_flow_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_flow_score_init"
                    android:textColor="#FF6B93"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_not_menstrual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/inset_surface"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_not_menstrual_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_not_menstrual_hint"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/btn_mark_menstrual"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary_background"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/record_detail_mark_menstrual"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_flow_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/tile_pink"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_flow_record_title"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_pbac_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_pad_staining_level"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/record_detail_pad_light"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_pad_light_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink_border"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#FF6B93"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_pad_light_count"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_pad_light_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/record_detail_pad_medium"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_pad_medium_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink_border"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#FF6B93"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_pad_medium_count_label"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_pad_medium_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/record_detail_pad_heavy"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_pad_heavy_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink_border"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#FF6B93"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_pad_heavy_count"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_pad_heavy_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_clot_size"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/record_detail_clot_small"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_clot_small_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink_border"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#FF6B93"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_clot_small_count"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_clot_small_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/record_detail_clot_large"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_clot_large_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink_border"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#FF6B93"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_clot_large_count"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_clot_large_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_pink"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_pain_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/tile_yellow"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_detail_pain"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/iv_pain_0"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_pain_0"
                        android:background="@drawable/pain_selector"
                        android:padding="8dp"/>

                    <ImageView
                        android:id="@+id/iv_pain_1"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_pain_1"
                        android:background="@drawable/pain_selector"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"/>

                    <ImageView
                        android:id="@+id/iv_pain_2"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_pain_2"
                        android:background="@drawable/pain_selector"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"/>

                    <ImageView
                        android:id="@+id/iv_pain_3"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_pain_3"
                        android:background="@drawable/pain_selector"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"/>

                    <ImageView
                        android:id="@+id/iv_pain_4"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_pain_4"
                        android:background="@drawable/pain_selector"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_pain_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/record_detail_pain_no_data"
                    android:textColor="#FF9800"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_notes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/record_detail_notes"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="@string/record_detail_notes_hint"
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_hint"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- 删除入口：仅在当天已存在“实际记录”时显示，预测占位记录不可删除 -->
    <TextView
        android:id="@+id/tv_delete"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="@string/record_detail_delete"
        android:textColor="#FF6B93"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingTop="0dp"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline_background"
            android:gravity="center"
            android:text="@string/record_detail_cancel"
            android:textColor="#FF6B93"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary_background"
            android:gravity="center"
            android:text="@string/record_detail_save"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
