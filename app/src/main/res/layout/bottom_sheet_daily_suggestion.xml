<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/divider"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/daily_suggestion_date_placeholder"
            android:textColor="@color/text_title"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/layout_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/phase_tag_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/cycle_menstrual_period_name"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/iv_phase_edit"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_hint"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 未来日期只展示预测，不能改阶段；该提示仅在未来日期出现 -->
    <TextView
        android:id="@+id/tv_future_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/daily_suggestion_future_hint"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:visibility="gone"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/daily_suggestion_title"
        android:textColor="@color/text_sub"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/inset_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/daily_suggestion_default"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 当日自定义提醒：该日期有提醒时显示，按时间排序 -->
    <LinearLayout
        android:id="@+id/layout_day_reminders_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/daily_suggestion_reminder_section"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

        <LinearLayout
            android:id="@+id/layout_day_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tv_prev_day"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline_background"
            android:gravity="center"
            android:text="@string/daily_suggestion_prev_day"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_next_day"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline_background"
            android:gravity="center"
            android:text="@string/daily_suggestion_next_day"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- 今日不再提醒：仅在“今日建议”弹窗中显示，底部脚注选项，与按钮保持舒展间距 -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_no_remind_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/daily_suggestion_no_remind_today"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
