<?xml version="1.0" encoding="utf-8"?>
<!--
    新增 / 编辑提醒弹窗。
    布局思路：顶部用一张摘要卡直接回答“什么时候提醒”，下面的表单按「内容 → 方式 → 时间/开关」分区，
    同一时间只展开当前方式需要的设置，避免整屏都是选项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <!-- ===== 摘要卡：一眼看懂提醒节奏 ===== -->
    <LinearLayout
        android:id="@+id/card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reminder_summary"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_summary_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_summary_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_unselected_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/brand_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_summary_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_summary_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== 常用提醒：横向滑动，点击即填充标题 / 备注 / 时间 ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_presets_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <!-- ===== 内容区：标题 + 备注合并为一张卡片 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_reminder_section"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/reminder_title_hint"
            android:inputType="text"
            android:maxLength="40"
            android:paddingVertical="8dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/reminder_message_hint"
            android:inputType="textMultiLine"
            android:maxLength="120"
            android:maxLines="3"
            android:minHeight="44dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== 提醒方式：自选日期 / 周期节点 / 阶段区间 ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/reminder_mode_label"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layout_mode_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_mode_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/chip_selected_background"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/reminder_mode_date"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_mode_cycle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/chip_unselected_background"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/reminder_mode_cycle"
            android:textColor="@color/text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_mode_phase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/chip_unselected_background"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/reminder_mode_phase"
            android:textColor="@color/text_body"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ===== 阶段区间：选一个阶段，阶段内每天提醒 ===== -->
    <LinearLayout
        android:id="@+id/layout_phase_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/layout_phase_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:id="@+id/tv_phase_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_phase_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_phase_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_phase_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:textColor="@color/text_body"
                android:textSize="13sp" />
        </GridLayout>

        <TextView
            android:id="@+id/tv_phase_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_phase_hint"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 周期节点：每个周期在节点当天提醒一次 ===== -->
    <LinearLayout
        android:id="@+id/layout_cycle_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reminder_node_label"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/layout_cycle_nodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2">

            <TextView
                android:id="@+id/tv_node_period_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_selected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_period_start"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_node_period_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_period_end"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_node_follicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_follicle"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_node_ovulation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_ovulation"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_node_luteal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_luteal"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_node_before_period"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_unselected_background"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/reminder_node_before_period"
                android:textColor="@color/text_body"
                android:textSize="13sp" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reminder_cycle_hint"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 自选日期：开始日期 + 重复规则 ===== -->
    <LinearLayout
        android:id="@+id/layout_date_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reminder_repeat_label"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/layout_repeat_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false" />

        <LinearLayout
            android:id="@+id/layout_start_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reminder_date_label"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_unselected_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/text_title"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_multi_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_multi_date_label"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layout_multi_date_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleLine="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_repeat_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_repeat_until"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layout_end_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleLine="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_weekdays_label"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layout_weekday_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false" />
        </LinearLayout>

        <!-- 每月：不再铺 31 个标签，只保留一个可点击的日期值 -->
        <LinearLayout
            android:id="@+id/layout_month_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reminder_month_day_label"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_month_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_unselected_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/text_title"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reminder_interval_label"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_interval_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="2"
                android:valueFrom="2"
                android:valueTo="30"
                app:haloColor="@color/tile_pink"
                app:thumbColor="@color/brand_primary"
                app:trackColorActive="@color/brand_primary"
                app:trackColorInactive="@color/outline_stroke" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 时间与开关：放在最后一张卡片里 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_reminder_section"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reminder_time_label"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_unselected_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/text_title"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_full_screen_label"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reminder_full_screen_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_full_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <!-- 权限不足时提示：全屏通知 / 悬浮窗未授权，到点只会显示横幅 -->
        <TextView
            android:id="@+id/tv_full_screen_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingHorizontal="2dp"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 强提醒响铃时长：关闭强提醒时整行隐藏 -->
        <LinearLayout
            android:id="@+id/layout_ring_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_ring_duration_label"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layout_ring_durations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reminder_enabled_label"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
